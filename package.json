{
  "name": "dr-shaimaa-minimal-tech-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,CLIENT -c blue,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "wait-on http-get://127.0.0.1:5000/api/health && vite --host 127.0.0.1",
    "dev:server": "nodemon server/index.js",
    "start": "node server/index.js",
    "seed": "node server/scripts/seedCases.js",
    "seed:admin": "node server/scripts/seedAdmin.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.44.0",
    "mongoose": "^9.10.0",
    "motion": "^13.2.0",
    "multer": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
